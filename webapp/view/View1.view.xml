<mvc:View controllerName="Z_GRN_Report_GC.controller.View1" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core"
	xmlns:table="sap.ui.table" displayBlock="true">
	<App>
		<Page id="reportPage" showHeader="false" enableScrolling="true">
			<content>
				<VBox class="reportRoot">
					<Toolbar class="reportHeader">
						<Title text="GRN Analytical Report" level="H1"/>
						<ToolbarSpacer/>
						<Button icon="sap-icon://refresh" tooltip="Refresh plant data from service" press="onRefresh" type="Transparent"/>
						<Button icon="sap-icon://excel-attachment" tooltip="Download GRN data as CSV" press="onExport" type="Transparent"/>
					</Toolbar>
					<VBox class="filterPanel">
						<Label text="Report filters" class="sectionEyebrow"/>
						<HBox wrap="Wrap" class="filterRow">
							<VBox class="filterField"><Label text="Plant"/>
								<Input id="plantInput" placeholder="Enter a plant" showSuggestion="true" filterSuggests="true" startSuggestion="1"
									suggestionItemSelected="onPlantSuggestionSelected" suggestionItems="{plantChoices>/rows}">
									<suggestionItems><core:ListItem key="{plantChoices>werks}" text="{plantChoices>werks}" additionalText="{plantChoices>plant_name}"/></suggestionItems>
								</Input>
							</VBox>
							<VBox class="filterField"><Label text="PO Number"/>
								<Input id="poInput" placeholder="Select a plant first" showSuggestion="true" filterSuggests="true" startSuggestion="1"
									suggestionItemSelected="onPoSuggestionSelected" suggestionItems="{poData>/rows}">
									<suggestionItems><core:ListItem key="{poData>ebeln}" text="{poData>ebeln}" additionalText="{poData>lifnr_name}"/></suggestionItems>
								</Input>
							</VBox>
							<VBox class="filterField dateField"><Label text="GRN Date From"/><DatePicker id="grnDateFrom" displayFormat="dd.MM.yyyy" valueFormat="yyyy-MM-dd" placeholder="DD.MM.YYYY"/></VBox>
							<VBox class="filterField dateField"><Label text="GRN Date To"/><DatePicker id="grnDateTo" displayFormat="dd.MM.yyyy" valueFormat="yyyy-MM-dd" placeholder="DD.MM.YYYY"/></VBox>
							<VBox class="filterActions"><Button text="Go" type="Emphasized" icon="sap-icon://search" press="onGo"/><Button text="Reset" press="onReset"/></VBox>
						</HBox>
						<Text text="Leave Plant blank to load all plants. GRN date range filters document details; select a plant and PO to view them."
							class="filterHint"/>
					</VBox>
					<MessageStrip id="messageStrip" visible="false" showIcon="true" type="Information" class="messageStrip"/>
					<Panel id="plantSummaryPanel" class="dataPanel summaryPanel" expandable="false">
						<headerToolbar>
							<Toolbar><core:Icon src="sap-icon://factory"/><Title text="Plant-wise Summary" level="H2"/><ToolbarSpacer/><ObjectStatus id="plantResultCount" text="{summary>/plantRows} plants" state="Information"/></Toolbar>
						</headerToolbar>
						<content>
							<HBox wrap="Wrap" class="kpiRow">
								<VBox class="kpiCard kpiBlue"><Text text="TOTAL PLANTS" class="kpiLabel"/><ObjectNumber number="{summary>/plantCount}"/></VBox>
								<VBox class="kpiCard kpiCyan"><Text text="TOTAL POs" class="kpiLabel"/><ObjectNumber number="{summary>/poCount}"/></VBox>
								<VBox class="kpiCard kpiTeal"><Text text="MATERIAL DOCUMENTS" class="kpiLabel"/><ObjectNumber number="{summary>/documentCount}"/></VBox>
								<VBox class="kpiCard kpiGreen"><Text text="COMPLETED" class="kpiLabel"/><ObjectNumber number="{summary>/completed}" state="Success"/></VBox>
								<VBox class="kpiCard kpiAmber"><Text text="PENDING" class="kpiLabel"/><ObjectNumber number="{summary>/pending}" state="Warning"/></VBox>
								<VBox class="kpiCard kpiRed"><Text text="REJECTED" class="kpiLabel"/><ObjectNumber number="{summary>/rejected}" state="Error"/></VBox>
								<VBox class="kpiCard kpiSlate"><Text text="CANCELLED" class="kpiLabel"/><ObjectNumber number="{summary>/cancelled}"/></VBox>
							</HBox>
							<HBox wrap="NoWrap" class="plantDashboard">
								<VBox class="dashboardDetails">
									<Panel class="miniPanel plantDetailsPanel" height="30rem" expandable="false">
										<headerToolbar>
											<Toolbar><Title text="Plant-wise Details" level="H3"/></Toolbar>
										</headerToolbar>
										<content>
											<table:Table id="plantTable" class="fixedDataTable plantDetailsTable" rows="{plantData>/rows}" width="100%" height="40rem"
												visibleRowCount="11" visibleRowCountMode="Fixed" selectionMode="Single" selectionBehavior="Row" rowSelectionChange="onPlantSelect"
												enableColumnReordering="false" enableBusyIndicator="true" busyIndicatorDelay="150">
												<table:noData><Text text="No plant records found"/></table:noData>
												<table:columns>
													<table:Column width="6rem" hAlign="Begin">
														<table:label><Label text="Plant"/></table:label>
														<table:template><ObjectIdentifier title="{plantData>werks}"/></table:template>
													</table:Column>
													<table:Column width="12rem" hAlign="Begin">
														<table:label><Label text="Plant Description"/></table:label>
														<table:template><Text text="{plantData>plant_name}" wrapping="false"/></table:template>
													</table:Column>
													<table:Column width="5rem" hAlign="End">
														<table:label><Label text="Total POs"/></table:label>
														<table:template><ObjectNumber number="{plantData>ebeln}"/></table:template>
													</table:Column>
													<table:Column width="8rem" hAlign="End">
														<table:label><Label text="Total Documents"/></table:label>
														<table:template><ObjectNumber number="{plantData>belnr}"/></table:template>
													</table:Column>
													<table:Column width="7rem" hAlign="End">
														<table:label><Label text="Completed"/></table:label>
														<table:template><ObjectNumber number="{plantData>completed}" state="Success"/></table:template>
													</table:Column>
													<table:Column width="6rem" hAlign="End">
														<table:label><Label text="Pending"/></table:label>
														<table:template><ObjectNumber number="{plantData>pending}" state="Warning"/></table:template>
													</table:Column>
													<table:Column width="6rem" hAlign="End">
														<table:label><Label text="Rejected"/></table:label>
														<table:template><ObjectNumber number="{plantData>rejected}" state="Error"/></table:template>
													</table:Column>
													<table:Column width="7rem" hAlign="End">
														<table:label><Label text="Cancelled"/></table:label>
														<table:template><Text text="{plantData>cancelled}"/></table:template>
													</table:Column>
												</table:columns>
											</table:Table>
										</content>
									</Panel>
								</VBox>
								<VBox class="dashboardCharts">
									<Panel id="statusChartPanel" class="miniPanel chartPanel statusChartPanel" height="14rem" expandable="false">
										<headerToolbar>
											<Toolbar><Title id="statusChartTitle" text="Document Status" level="H3"/><ToolbarSpacer/><Text text="{statusChart>/total} documents"/></Toolbar>
										</headerToolbar>
										<content>
											<HBox class="statusChartBody" alignItems="Center" justifyContent="Center">
												<core:HTML class="statusDonutHost" content="{statusChart>/donutHtml}" sanitizeContent="false"/>
												<VBox class="statusLegend" items="{statusChart>/rows}">
													<items>
														<HBox class="statusLegendRow" alignItems="Center"><ObjectStatus text="{statusChart>status}" state="{statusChart>state}"/><ToolbarSpacer/><Text text="{statusChart>countText}"/><Text text="{statusChart>percentText}" class="statusPercent"/></HBox>
													</items>
												</VBox>
											</HBox>
										</content>
									</Panel>
									<Panel id="topPlantChartPanel" class="miniPanel chartPanel topPlantsPanel" height="16rem" expandable="false">
										<headerToolbar>
											<Toolbar><Title id="topPlantChartTitle" text="Top 5 Plants by Total Documents" level="H3"/></Toolbar>
										</headerToolbar>
										<content>
											<VBox class="topPlantsChart" items="{topPlantChart>/rows}">
												<items>
													<HBox class="topPlantRow" alignItems="Center"><Text text="{topPlantChart>plant}" class="topPlantLabel"/><core:HTML class="topPlantBarHost" content="{topPlantChart>barHtml}" sanitizeContent="false"/><Text text="{topPlantChart>documentsText}" class="topPlantValue"/></HBox>
												</items>
											</VBox>
										</content>
									</Panel>
								</VBox>
							</HBox>
						</content>
					</Panel>
					<Panel id="poPanel" class="dataPanel" expandable="false">
						<headerToolbar>
							<Toolbar><core:Icon src="sap-icon://shipping-status"/><Title id="poTitle" text="PO-wise Summary" level="H2"/><ToolbarSpacer/><ObjectStatus id="selectedPlant" text="All plants" state="Information"/></Toolbar>
						</headerToolbar>
						<table:Table id="poTable" class="fixedDataTable" rows="{poData>/rows}" width="100%" height="25rem" visibleRowCount="10"
							visibleRowCountMode="Fixed" selectionMode="Single" selectionBehavior="Row" rowSelectionChange="onPoSelect" enableColumnReordering="false"
							enableBusyIndicator="true" busyIndicatorDelay="150">
							<table:noData><Text text="Select a plant to load purchase orders"/></table:noData>
							<table:columns>
								<table:Column width="10rem">
									<table:label><Label text="PO Number"/></table:label>
									<table:template><ObjectIdentifier title="{poData>ebeln}"/></table:template>
								</table:Column>
								<table:Column width="8rem">
									<table:label><Label text="Vendor"/></table:label>
									<table:template><Text text="{poData>lifnr}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="15rem">
									<table:label><Label text="Vendor Name"/></table:label>
									<table:template><Text text="{poData>lifnr_name}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="9rem">
									<table:label><Label text="PO Date"/></table:label>
									<table:template><Text text="{poData>bedat}"/></table:template>
								</table:Column>
								<table:Column width="8rem" hAlign="End">
									<table:label><Label text="GRN Docs"/></table:label>
									<table:template><ObjectNumber number="{poData>mblnr}"/></table:template>
								</table:Column>
								<table:Column width="6rem" hAlign="End">
									<table:label><Label text="103"/></table:label>
									<table:template><Text text="{poData>mblnr_103}"/></table:template>
								</table:Column>
								<table:Column width="6rem" hAlign="End">
									<table:label><Label text="105"/></table:label>
									<table:template><Text text="{poData>mblnr_105}"/></table:template>
								</table:Column>
								<table:Column width="8rem" hAlign="End">
									<table:label><Label text="Completed"/></table:label>
									<table:template><ObjectNumber number="{poData>completed}" state="Success"/></table:template>
								</table:Column>
								<table:Column width="7rem" hAlign="End">
									<table:label><Label text="Pending"/></table:label>
									<table:template><ObjectNumber number="{poData>pending}" state="Warning"/></table:template>
								</table:Column>
								<table:Column width="7rem" hAlign="End">
									<table:label><Label text="Rejected"/></table:label>
									<table:template><ObjectNumber number="{poData>rejected}" state="Error"/></table:template>
								</table:Column>
								<table:Column width="7rem" hAlign="End">
									<table:label><Label text="Cancelled"/></table:label>
									<table:template><Text text="{poData>cancelled}"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="Storage Location"/></table:label>
									<table:template><Text text="{poData>lgort}"/></table:template>
								</table:Column>
							</table:columns>
						</table:Table>
					</Panel>
					<Panel id="grnPanel" class="dataPanel" expandable="false">
						<headerToolbar>
							<Toolbar><core:Icon src="sap-icon://document-text"/><Title id="grnTitle" text="GRN / Material Document Details" level="H2"/><ToolbarSpacer/><ObjectStatus id="selectedPo" text="Select a PO" state="Information"/></Toolbar>
						</headerToolbar>
						<table:Table id="grnTable" class="fixedDataTable" rows="{grnData>/rows}" width="100%" height="25rem" visibleRowCount="10"
							visibleRowCountMode="Fixed" selectionMode="None" enableColumnReordering="false" enableBusyIndicator="true" busyIndicatorDelay="150">
							<table:noData><Text text="Select a plant and PO to load GRN documents"/></table:noData>
							<table:columns>
								<table:Column width="10rem">
									<table:label><Label text="Material Document"/></table:label>
									<table:template><Text text="{grnData>mblnr}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="7rem">
									<table:label><Label text="Movement"/></table:label>
									<table:template><Text text="{grnData>bwart}"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="Reference Doc."/></table:label>
									<table:template><Text text="{grnData>lfbnr}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="Invoice"/></table:label>
									<table:template><Text text="{grnData>xblnr}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="12rem">
									<table:label><Label text="Material"/></table:label>
									<table:template><Text text="{grnData>matnr}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="20rem">
									<table:label><Label text="Description"/></table:label>
									<table:template><Text text="{grnData>maktx}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="6rem">
									<table:label><Label text="UoM"/></table:label>
									<table:template><Text text="{grnData>meins}"/></table:template>
								</table:Column>
								<table:Column width="9rem" hAlign="End">
									<table:label><Label text="PO Qty"/></table:label>
									<table:template><Text text="{grnData>menge}"/></table:template>
								</table:Column>
								<table:Column width="9rem" hAlign="End">
									<table:label><Label text="GRN Qty"/></table:label>
									<table:template><Text text="{grnData>acqty}"/></table:template>
								</table:Column>
								<table:Column width="10rem" hAlign="End">
									<table:label><Label text="Invoice Qty"/></table:label>
									<table:template><Text text="{grnData>menge_i}"/></table:template>
								</table:Column>
								<table:Column width="10rem" hAlign="End">
									<table:label><Label text="Rejection Qty"/></table:label>
									<table:template><Text text="{grnData>rjqty}"/></table:template>
								</table:Column>
								<table:Column width="8rem">
									<table:label><Label text="Status"/></table:label>
									<table:template><ObjectStatus text="{grnData>status}"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="GRN Date"/></table:label>
									<table:template><Text text="{grnData>budat}"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="Post Date"/></table:label>
									<table:template><Text text="{grnData>budat_mkpf}"/></table:template>
								</table:Column>
								<table:Column width="8rem">
									<table:label><Label text="Time"/></table:label>
									<table:template><Text text="{grnData>cputm}"/></table:template>
								</table:Column>
								<table:Column width="8rem">
									<table:label><Label text="Storage"/></table:label>
									<table:template><Text text="{grnData>lgort}"/></table:template>
								</table:Column>
								<table:Column width="10rem">
									<table:label><Label text="GRN User"/></table:label>
									<table:template><Text text="{grnData>usnam}"/></table:template>
								</table:Column>
								<table:Column width="20rem">
									<table:label><Label text="Remarks"/></table:label>
									<table:template><Text text="{grnData>bktxt}" wrapping="false"/></table:template>
								</table:Column>
								<table:Column width="10rem" hAlign="End">
									<table:label><Label text="Ageing (Days)"/></table:label>
									<table:template><Text text="{grnData>vend_age}"/></table:template>
								</table:Column>
							</table:columns>
						</table:Table>
						<Toolbar class="tableFooter"><Text id="grnFooter" text="Select a PO to view its GRN documents."/><ToolbarSpacer/><Button text="Download CSV" icon="sap-icon://excel-attachment" press="onExport"/></Toolbar>
					</Panel>
				</VBox>
			</content>
		</Page>
	</App>
</mvc:View>